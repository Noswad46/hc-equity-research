---
/**
 * One statically generated page per covered company (SPEC §8).
 *
 * Every figure on this page is printed exactly as `run.py` emitted it. There is
 * no rounding, no scaling to millions and no substitution of a dash for a
 * missing value — a null renders as the word "null", because a figure that does
 * not exist must not look like a zero.
 */
import Base from "../../layouts/Base.astro";
import meta from "../../data/meta.json";
import {
  describeFlag,
  describeReason,
  severityOf,
  SEVERITY_ORDER,
  conceptLabel,
  basisLabel,
  raw,
  type QualityRecord,
} from "../../lib/flags";

const QUARTERS_SHOWN = 12;
const YEARS_SHOWN = 5;
const COLUMNS = ["revenue", "rnd", "ocf", "cash"] as const;

export async function getStaticPaths() {
  const files = import.meta.glob("../../data/companies/*.json", { eager: true });
  return Object.values(files).map((mod: any) => {
    const company = mod.default ?? mod;
    return { params: { ticker: company.ticker }, props: { company } };
  });
}

const { company } = Astro.props;

const quarters = company.quarterly.slice(-QUARTERS_SHOWN).reverse();
const years = company.annual.slice(-YEARS_SHOWN).reverse();

const flags: QualityRecord[] = [...company.data_quality].sort(
  (a: QualityRecord, b: QualityRecord) => {
    const bySeverity = SEVERITY_ORDER[severityOf(a.code)] - SEVERITY_ORDER[severityOf(b.code)];
    if (bySeverity !== 0) return bySeverity;
    return (b.period_end ?? "").localeCompare(a.period_end ?? "");
  },
);

const conceptEntries = Object.entries(company.concepts) as [string, any][];
const activeTrials = (company.active_trials_detail ?? []).slice().sort(
  (a: any, b: any) => (b.start_date ?? "").localeCompare(a.start_date ?? ""),
);
---

<Base title={`${company.ticker} — ${company.name}`}>
  <p class="muted"><a href="/companies/">← All companies</a></p>

  <h1>{company.name}</h1>
  <p class="muted">{company.ticker} · {company.subsector}</p>

  <dl class="meta">
    <dt>Ticker</dt><dd>{company.ticker}</dd>
    <dt>CIK</dt><dd>{company.cik}</dd>
    <dt>Registrant</dt><dd>{company.entity_name}</dd>
    <dt>Subsector</dt><dd>{company.subsector}</dd>
    <dt>Therapeutic focus</dt><dd>{company.therapeutic_focus.join(", ") || "—"}</dd>
    <dt>Fiscal period end</dt>
    <dd class={company.fiscal_period_end === null ? "null" : ""}>
      {raw(company.fiscal_period_end)}
    </dd>
    <dt>Data as of</dt><dd>{meta.generated_at}</dd>
    <dt>Taxonomies</dt><dd>{company.taxonomies.join(", ")}</dd>
  </dl>

  <h2>Trailing twelve months</h2>
  <table>
    <caption>Sum of the four most recent discrete quarters. Null where they do not tile cleanly.</caption>
    <thead>
      <tr><th>Measure</th><th class="num">Value (USD)</th></tr>
    </thead>
    <tbody>
      <tr>
        <td>Revenue</td>
        <td class={`num ${company.revenue_ttm === null ? "null" : ""}`}>{raw(company.revenue_ttm)}</td>
      </tr>
      <tr>
        <td>R&D expense</td>
        <td class={`num ${company.rnd_ttm === null ? "null" : ""}`}>{raw(company.rnd_ttm)}</td>
      </tr>
      <tr>
        <td>Operating cash flow</td>
        <td class={`num ${company.ocf_ttm === null ? "null" : ""}`}>{raw(company.ocf_ttm)}</td>
      </tr>
      <tr>
        <td>Cash (latest balance)</td>
        <td class={`num ${company.cash === null ? "null" : ""}`}>{raw(company.cash)}</td>
      </tr>
      <tr>
        <td>Revenue growth, year on year</td>
        <td class={`num ${company.revenue_growth_yoy === null ? "null" : ""}`}>
          {raw(company.revenue_growth_yoy)}
        </td>
      </tr>
    </tbody>
  </table>

  <h2>Quarterly</h2>
  <table>
    <caption>Last {QUARTERS_SHOWN} discrete quarters, most recent first. Figures in USD, as filed.</caption>
    <thead>
      <tr>
        <th>Period start</th>
        <th>Period end</th>
        {COLUMNS.map((c) => <th class="num">{conceptLabel(c)}</th>)}
        <th>Basis</th>
        <th>Flags</th>
      </tr>
    </thead>
    <tbody>
      {quarters.map((row: any) => (
        <tr>
          <td>{row.period_start}</td>
          <td>{row.period_end}</td>
          {COLUMNS.map((c) => (
            <td class={`num ${row[c] === null ? "null" : ""}`}>{raw(row[c])}</td>
          ))}
          <td class="muted">
            {COLUMNS.filter((c) => row.source_basis[c])
              .map((c) => `${c}: ${row.source_basis[c]}`)
              .join(", ")}
          </td>
          <td class="muted">{row.flags.length ? row.flags.join(", ") : "—"}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>Annual</h2>
  <table>
    <caption>
      Last {YEARS_SHOWN} fiscal years, most recent first. Flow figures are the filer's own reported
      year, not a sum of quarters. Cash is the balance at the fiscal year end.
    </caption>
    <thead>
      <tr>
        <th>Fiscal year end</th>
        {COLUMNS.map((c) => <th class="num">{conceptLabel(c)}</th>)}
        <th class="num">Revenue growth YoY</th>
        <th>Suppressed by</th>
      </tr>
    </thead>
    <tbody>
      {years.map((row: any) => (
        <tr>
          <td>{row.period_end}</td>
          {COLUMNS.map((c) => (
            <td class={`num ${row[c] === null ? "null" : ""}`}>{raw(row[c])}</td>
          ))}
          <td class={`num ${row.revenue_growth_yoy.value === null ? "null" : ""}`}>
            {raw(row.revenue_growth_yoy.value)}
          </td>
          <td class="muted">
            {row.revenue_growth_yoy.suppressed_by.length
              ? row.revenue_growth_yoy.suppressed_by.join(", ")
              : "—"}
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>Tag basis</h2>
  <table>
    <caption>
      Which XBRL tag supplied each concept, and what it measures. Where a series changes basis
      partway, the cutover is named — the step at that point is a change of definition, not of the
      business.
    </caption>
    <thead>
      <tr>
        <th>Concept</th>
        <th>Tags used</th>
        <th>Measurement basis</th>
        <th>Basis cutover</th>
        <th>Latest period</th>
      </tr>
    </thead>
    <tbody>
      {conceptEntries.map(([name, c]) => (
        <tr>
          <td>{conceptLabel(name)}</td>
          <td class="muted">{c.tags_used.length ? c.tags_used.join(", ") : "—"}</td>
          <td class="muted">
            {c.measurement_bases.length
              ? c.measurement_bases.map((b: string) => basisLabel(b)).join(" → ")
              : "—"}
          </td>
          <td class="muted">
            {c.basis_cutovers.length
              ? c.basis_cutovers
                  .map(
                    (x: any) =>
                      `${basisLabel(x.from_basis)} → ${basisLabel(x.to_basis)}, between ${x.last_period_end_before} and ${x.first_period_end_after}`,
                  )
                  .join("; ")
              : "—"}
          </td>
          <td class={c.latest_period_end === null ? "null" : ""}>
            {raw(c.latest_period_end)}
            {c.is_stale && <span class="muted"> ({c.staleness_days} days behind)</span>}
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>Clinical pipeline</h2>
  {company.pipeline === null ? (
    <p class="muted">No clinical data for this company.</p>
  ) : (
    <>
      <p class="muted">
        Interventional studies where this company is the <strong>lead</strong> sponsor, from
        ClinicalTrials.gov as of {company.pipeline.as_of}. Sponsor strings are matched whole-field:{" "}
        {company.pipeline.sponsors.map((s: string) => <code>{s}</code>).reduce((a: any, b: any) => [a, ", ", b])}.
      </p>

      <table>
        <caption>Active trials by phase. A trial declaring several phases counts once, at its highest.</caption>
        <thead>
          <tr><th>Phase</th><th class="num">Active trials</th></tr>
        </thead>
        <tbody>
          {[["phase_1","Phase 1"],["phase_2","Phase 2"],["phase_3","Phase 3"],["phase_4","Phase 4"],["not_applicable","Not applicable"]].map(([key,label]) => (
            <tr>
              <td>{label}</td>
              <td class="num">{raw(company.pipeline.by_phase[key] ?? 0)}</td>
            </tr>
          ))}
          <tr>
            <td><strong>Total active</strong></td>
            <td class="num"><strong>{raw(company.pipeline.active_trials_total)}</strong></td>
          </tr>
          <tr>
            <td class="muted">All trials, all time</td>
            <td class="num muted">{raw(company.pipeline.total_trials)}</td>
          </tr>
        </tbody>
      </table>

      <table>
        <caption>Pipeline metrics. Weights and thresholds are on the <a href="/methodology/">methodology page</a>.</caption>
        <thead>
          <tr><th>Metric</th><th class="num">Value</th><th>Suppressed by</th></tr>
        </thead>
        <tbody>
          {[
            ["pipeline_depth_score","Depth score"],
            ["pipeline_concentration","Concentration (HHI)"],
            ["clinical_momentum","Clinical momentum"],
            ["discontinuation_rate","Discontinuation rate"],
            ["rnd_per_late_stage_programme","R&D per late-stage programme (USD)"],
          ].map(([key,label]) => (
            <tr>
              <td>{label}</td>
              <td class={`num ${company[key]?.value === null ? "null" : ""}`}>{raw(company[key]?.value)}</td>
              <td class="muted">
                {company[key]?.suppressed_by?.length
                  ? company[key].suppressed_by.map((c: string) => describeReason(c, label)).join(" ")
                  : "—"}
              </td>
            </tr>
          ))}
          <tr>
            <td class="muted">Trials started, trailing 12m / prior 12m</td>
            <td class="num muted">{raw(company.pipeline.started_ttm)} / {raw(company.pipeline.started_prior_ttm)}</td>
            <td class="muted">Registration lags the start date, so recent months under-count.</td>
          </tr>
        </tbody>
      </table>

      {company.pipeline.top_conditions.length > 0 && (
        <table>
          <caption>Most-addressed conditions across active trials.</caption>
          <thead><tr><th>Condition</th><th class="num">Active trials</th></tr></thead>
          <tbody>
            {company.pipeline.top_conditions.map((c: any) => (
              <tr><td>{c.condition}</td><td class="num">{raw(c.count)}</td></tr>
            ))}
          </tbody>
        </table>
      )}

      {company.pipeline.upcoming_readouts.length > 0 && (
        <table>
          <caption>Next primary completion dates among active trials.</caption>
          <thead>
            <tr><th>Primary completion</th><th>Phase</th><th>Condition</th><th class="num">Enrolment</th><th>NCT</th></tr>
          </thead>
          <tbody>
            {company.pipeline.upcoming_readouts.map((r: any) => (
              <tr>
                <td>{raw(r.primary_completion_date)}</td>
                <td>{raw(r.phase)}</td>
                <td>{r.condition ?? "—"}</td>
                <td class={`num ${r.enrollment === null ? "null" : ""}`}>{raw(r.enrollment)}</td>
                <td><a href={r.url}>{r.nct_id}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      {activeTrials.length > 0 && (
        <>
          <h3>Active trials ({activeTrials.length})</h3>
          <div style="max-height: 30rem; overflow: auto;">
            <table>
              <thead>
                <tr><th>NCT</th><th>Phase</th><th>Status</th><th>Started</th><th class="num">Enrolment</th><th>Title</th></tr>
              </thead>
              <tbody>
                {activeTrials.map((t: any) => (
                  <tr>
                    <td><a href={t.url}>{t.nct_id}</a></td>
                    <td>{t.phases.length ? t.phases.join(", ") : "—"}</td>
                    <td class="muted">{t.status}</td>
                    <td>{raw(t.start_date)}</td>
                    <td class={`num ${t.enrollment === null ? "null" : ""}`}>{raw(t.enrollment)}</td>
                    <td>{t.title}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )}
    </>
  )}

  <h2>Data quality</h2>
  {flags.length === 0 ? (
    <p>No flags were raised on this record.</p>
  ) : (
    <>
      <p class="muted">
        {flags.length} item{flags.length === 1 ? "" : "s"}. Everything the pipeline noticed about
        this record is listed here, most serious first.
      </p>
      {flags.map((record) => (
        <div class="flag" data-severity={severityOf(record.code)}>
          <div>{describeFlag(record)}</div>
          <code>
            {record.code}
            {record.period_end ? ` · period ${record.period_start ?? "?"} to ${record.period_end}` : ""}
          </code>
        </div>
      ))}
    </>
  )}

  <h2>Sources</h2>
  <p class="muted">
    The SEC filings these figures were read from. Every number on this page traces to one of them.
  </p>
  <table>
    <thead>
      <tr><th>Form</th><th>Filed</th><th>Accession</th></tr>
    </thead>
    <tbody>
      {company.filings.map((f: any) => (
        <tr>
          <td>{f.form}</td>
          <td>{f.filed}</td>
          <td><a href={f.url}>{f.accession}</a></td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>
